# Copy to .env and adjust. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Database ---
# Inside docker-compose the host is the "db" service.
# Leave DATABASE_URL empty to fall back to a local SQLite file (handy for tests).
DATABASE_URL=postgres://learnhub:learnhub@db:5432/learnhub
POSTGRES_USER=learnhub
POSTGRES_PASSWORD=learnhub
POSTGRES_DB=learnhub

# Serve /media/ uploads from Django (set 0 when nginx / S3 handles them)
SERVE_MEDIA=1

# --- Security ---
# Login lockout: failures per username+IP before a 15 minute cool-off
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15
# Set to 1 when running behind a reverse proxy so the real client IP is used
AXES_PROXY_COUNT=0
# Set to 1 to only report CSP violations (header Content-Security-Policy-Report-Only)
CSP_REPORT_ONLY=0

# --- Bootstrapping ---
# When 1, the container seeds demo courses + accounts on first start (idempotent).
SEED_DEMO=1
# Optional: create a superuser on start if it does not exist.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin12345
